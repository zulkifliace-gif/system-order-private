# ============================================================
# LajuQ F&B Order System — Konfigurasi Environment Variable (.env)
# Salin fail ini kepada '.env' sebelum menjalankan sistem.
# ============================================================

# ── Konfigurasi Server ──────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Laluan Pangkalan Data SQLite (Pilihan) ──────────────────
# Di dalam Docker, laluan ini automatik dihalakan ke volume 'data/'
DB_PATH=/app/fb-order-backend/data/fb_ordering.db

# ── Cloudflare Named Tunnel (Pilihan - URL Kekal & HTTPS Percuma)
# Dapatkan Token daripada Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
# Contoh: eyJhIjoiYmQ4Zj... (Jika diisi, tunnel domain kekal akan auto-aktif)
CLOUDFLARE_TUNNEL_TOKEN=

# ── Integrasi Telegram Bot (Pilihan - Maklum Balas Pelanggan) 
# Dapatkan Token daripada @BotFather di Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID atau Group ID Telegram (cth: -100xxxxxxxxxx atau 123456789)
TELEGRAM_CHAT_ID=

# ── Web Push Notification VAPID Keys (Pilihan) ──────────────
# Kunci penyulitan untuk notifikasi tolak pelayar web
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
